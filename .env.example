# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# REQUIRED: your course-authorized OpenAI API key.
# This is NOT your ChatGPT subscription. Ask Eric for API access / credits.
# >>> REPLACE THE PLACEHOLDER BELOW WITH YOUR ACTUAL KEY <<<
OPENAI_API_KEY=sk-REPLACE_ME_WITH_YOUR_COURSE_API_KEY

# Base model used for zero-shot and few-shot prompting.
# Record the exact snapshot you are approved to use.
SRL_MODEL=gpt-4o-mini-2024-07-18

# Base model to fine-tune (must be fine-tuning eligible; check with Eric).
SRL_FT_BASE_MODEL=gpt-4o-mini-2024-07-18

# Set this AFTER a fine-tuning job completes (notebook 04 prints the id).
# SRL_FINETUNED_MODEL=ft:gpt-4o-mini-2024-07-18:your-org::XXXXXXXX
